ope                                      INSTRUME= 'Kepler Photometer'  / detector type                                  OBJECT  = 'KIC 4862625'        / string version of target id                    KEPLERID=              4862625 / unique Kepler target identifier                RADESYS = 'ICRS    '           / reference frame of celestial coordinates       RA_OBJ  =           298.215101 / [deg] right ascension                          DEC_OBJ =            39.955100 / [deg] declination                              EQUINOX =               2000.0 / equinox of celestial coordinate system         WCSAXES =                    2 / number of WCS axes                             CTYPE1  = 'RA---TAN'           / right ascension coordinate type                CTYPE2  = 'DEC--TAN'           / declination coordinate type                    CRPIX1  =   3.9121952874057797 / [pixel] reference pixel along image axis 1     CRPIX2  =   2.8581546952359247 / [pixel] reference pixel along image axis 2     CRVAL1  =          298.2151005 / [deg] right ascension at reference pixel       CRVAL2  =              39.9551 / [deg] declination at reference pixel           CUNIT1  = 'deg     '           / physical unit in column dimension              CUNIT2  = 'deg     '           / physical unit in row dimension                 CDELT1  =   -0.001102550607266 / [deg] pixel scale in RA dimension              CDELT2  =    0.001102550607266 / [deg] pixel scale in Dec dimension             PC1_1   =  -0.8828463417647101 / linear transformation element cos(th)          PC1_2   =   0.4668724916364618 / linear transformation element -sin(th)         PC2_1   =  0.46819667054975894 / linear transformation element sin(th)          PC2_2   =    0.885105161428867 / linear transformation element cos(th)          WCSNAMEP= 'PHYSICAL'           / name of world coordinate system alternate P    WCSAXESP=                    2 / number of WCS physical axes                    CTYPE1P = 'RAWX    '           / physic